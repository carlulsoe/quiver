{
  "name": "quiver-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "target:up": "bash scripts/crapi-up.sh",
    "target:down": "bash scripts/crapi-down.sh",
    "spike:flue": "bun src/prototype/flue-bun-spike.ts",
    "prototype": "bun src/prototype/cli.ts",
    "evals": "bunx --bun vitest run --config vitest.evals.config.ts",
    "evals:json": "bunx --bun vitest run --config vitest.evals.config.ts --reporter=vitest-evals/reporter --reporter=json --outputFile.json=.prototype/eval-results.json",
    "evals:report": "bunx --bun vitest-evals serve .prototype/eval-results.json",
    "test": "bunx --bun vitest run --config vitest.config.ts",
    "test:all": "bun run test && bun run test:integration",
    "test:integration": "bunx --bun vitest run --config vitest.integration.config.ts",
    "test:watch": "bunx --bun vitest --config vitest.config.ts",
    "verify": "bun run check && bun run test",
    "check": "oxfmt --check . && oxlint && tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.0.3",
    "valibot": "1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "latest",
    "vitest": "4.1.11",
    "vitest-evals": "0.16.1"
  }
}
