{
  "name": "quiver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "target:up": "bash scripts/crapi-up.sh",
    "target:down": "bash scripts/crapi-down.sh",
    "target:held-out": "bun src/targets/held-out-server.ts",
    "target:broken-crystals:up": "bash scripts/broken-crystals-up.sh",
    "target:broken-crystals:down": "bash scripts/broken-crystals-down.sh",
    "target:vulnerableapp:up": "bash scripts/vulnerableapp-up.sh",
    "target:vulnerableapp:down": "bash scripts/vulnerableapp-down.sh",
    "target:vampi:up": "bash scripts/vampi-up.sh",
    "target:vampi:down": "bash scripts/vampi-down.sh",
    "campaign": "bun src/prototype/cli.ts",
    "evals": "bun scripts/run-evals.ts",
    "evals:json": "bun scripts/run-evals.ts",
    "evals:single": "bun --bun vitest run --config vitest.evals.config.ts",
    "evals:report": "bun --bun vitest-evals serve .prototype/eval-results.json",
    "test": "bun --bun vitest run --config vitest.config.ts",
    "test:all": "bun run test && bun run test:integration",
    "test:integration": "bun --bun vitest run --config vitest.integration.config.ts",
    "test:watch": "bun --bun vitest --config vitest.config.ts",
    "test:lint-plugin": "bun tools/oxlint/anti-slop/fixtures/verify-fixtures.ts",
    "browser:install": "playwright-core install chromium",
    "verify": "bun run check && bun run test:lint-plugin && bun run test",
    "security:secrets": "bash scripts/check-secrets.sh",
    "check": "oxfmt --check . && oxlint && bun run check:types",
    "check:types": "tsc --noEmit && tsc --project tsconfig.tools.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.0.3",
    "playwright-core": "1.62.1",
    "valibot": "^1.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/bun": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "vitest-evals": "0.16.1"
  },
  "packageManager": "bun@1.4.0"
}
